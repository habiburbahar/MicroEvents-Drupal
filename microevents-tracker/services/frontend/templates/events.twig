<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Event Manager</title>
  <!-- Bootstrap CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</head>
<body class="bg-light">
  <div class="container py-5">
    <h1 class="text-center mb-5">Event Manager</h1>

    <div class="row mb-4">
      <div class="col-md-6">
        <h3>Upcoming Events</h3>
        <ul id="eventList" class="list-group"></ul>
      </div>
      <div class="col-md-6">
        <h3>Create or Update Event</h3>
        <form id="eventForm">
          <input type="hidden" name="id" id="eventId">
          <div class="mb-3">
            <input type="text" name="title" class="form-control" placeholder="Title" required>
          </div>
          <div class="mb-3">
            <input type="date" name="date" class="form-control" required>
          </div>
          <div class="mb-3">
            <input type="text" name="location" class="form-control" placeholder="Location" required>
          </div>
          <button type="submit" class="btn btn-primary">Save Event</button>
        </form>
      </div>
    </div>

    <hr>

    <div class="row">
      <div class="col-md-6">
        <h3>Notifications</h3>
        <ul id="notificationList" class="list-group"></ul>
      </div>
      <div class="col-md-6">
        <h3>Create or Update Notification</h3>
        <form id="notificationForm">
          <input type="hidden" name="id" id="notificationId">
          <div class="mb-3">
            <input type="text" name="message" class="form-control" placeholder="Message" required>
          </div>
          <div class="mb-3">
            <input type="datetime-local" name="time" class="form-control" required>
          </div>
          <button type="submit" class="btn btn-primary">Save Notification</button>
        </form>
      </div>
    </div>
  </div>

  <script>
    const API_TOKEN = 'supersecrettoken';

    function loadEvents() {
      fetch('http://localhost:8001/api/events.php', {
        headers: { 'Authorization': 'Bearer ' + API_TOKEN }
      })
      .then(res => res.json())
      .then(events => {
        const list = document.getElementById('eventList');
        list.innerHTML = '';
        events.forEach(event => {
          const li = document.createElement('li');
          li.className = 'list-group-item';
          li.innerHTML = `
            <strong>${event.title}</strong><br>
            📅 ${event.date} | 📍 ${event.location} <br>
            <button class='btn btn-sm btn-secondary mt-1' onclick='editEvent(${JSON.stringify(event)})'>Edit</button>
            <button class='btn btn-sm btn-danger mt-1' onclick='deleteEvent(${event.id})'>Delete</button>
          `;
          list.appendChild(li);
        });
      });
    }

    function editEvent(event) {
      document.getElementById('eventId').value = event.id;
      document.querySelector('[name="title"]').value = event.title;
      document.querySelector('[name="date"]').value = event.date;
      document.querySelector('[name="location"]').value = event.location;
    }

    function deleteEvent(id) {
      fetch('http://localhost:8001/api/events.php', {
        method: 'DELETE',
        headers: {
          'Authorization': 'Bearer ' + API_TOKEN,
          'Content-Type': 'application/json'
        },
        body: JSON.stringify({ id })
      })
      .then(() => loadEvents());
    }

    document.getElementById('eventForm').addEventListener('submit', function(e) {
      e.preventDefault();
      const form = e.target;
      const id = form.id.value;
      const data = {
        title: form.title.value,
        date: form.date.value,
        location: form.location.value
      };
      let method = 'POST';
      if (id) {
        data.id = id;
        method = 'PUT';
      }

      fetch('http://localhost:8001/api/events.php', {
        method,
        headers: {
          'Authorization': 'Bearer ' + API_TOKEN,
          'Content-Type': 'application/json'
        },
        body: JSON.stringify(data)
      })
      .then(() => {
        form.reset();
        loadEvents();
      });
    });

    function loadNotifications() {
      fetch('http://localhost:8002/api/notifications.php', {
        headers: { 'Authorization': 'Bearer ' + API_TOKEN }
      })
      .then(res => res.json())
      .then(notifications => {
        const list = document.getElementById('notificationList');
        list.innerHTML = '';
        notifications.forEach(note => {
          const li = document.createElement('li');
          li.className = 'list-group-item';
          li.innerHTML = `🔔 ${note.message} at ${note.time} <br>
            <button class='btn btn-sm btn-secondary mt-1' onclick='editNotification(${JSON.stringify(note)})'>Edit</button>
            <button class='btn btn-sm btn-danger mt-1' onclick='deleteNotification(${note.id})'>Delete</button>`;
          list.appendChild(li);
        });
      });
    }

    function editNotification(note) {
      document.getElementById('notificationId').value = note.id;
      document.querySelector('[name="message"]').value = note.message;
      document.querySelector('[name="time"]').value = note.time.replace(' ', 'T');
    }

    function deleteNotification(id) {
      fetch('http://localhost:8002/api/notifications.php', {
        method: 'DELETE',
        headers: {
          'Authorization': 'Bearer ' + API_TOKEN,
          'Content-Type': 'application/json'
        },
        body: JSON.stringify({ id })
      })
      .then(() => loadNotifications());
    }

    document.getElementById('notificationForm').addEventListener('submit', function(e) {
      e.preventDefault();
      const form = e.target;
      const id = form.id.value;
      const data = {
        message: form.message.value,
        time: form.time.value
      };
      let method = 'POST';
      if (id) {
        data.id = id;
        method = 'PUT';
      }

      fetch('http://localhost:8002/api/notifications.php', {
        method,
        headers: {
          'Authorization': 'Bearer ' + API_TOKEN,
          'Content-Type': 'application/json'
        },
        body: JSON.stringify(data)
      })
      .then(() => {
        form.reset();
        loadNotifications();
      });
    });

    loadEvents();
    loadNotifications();
  </script>
</body>
</html>
